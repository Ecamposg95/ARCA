# ARCA — variables de entorno

# Obligatorias en producción (la app no arranca sin ellas):
DATABASE_URL=postgresql://user:pass@host:5432/arca
SECRET_KEY=cambia-esto-por-un-secreto-de-al-menos-32-caracteres

# Entorno: development | production
ENV=development

# CORS: orígenes separados por coma. Vacío = sin CORS (misma-origen, el caso normal:
# FastAPI sirve la SPA). Solo se necesita si el frontend vive en otro dominio.
CORS_ORIGINS=

# Opcionales
ACCESS_TOKEN_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_DAYS=30
DOCS_ENABLED=false
